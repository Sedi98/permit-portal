{
  "name": "permit-portal",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "pnpm --filter @permit-portal/operator dev",
    "dev:operator": "pnpm --filter @permit-portal/operator dev",
    "dev:web": "pnpm --filter @permit-portal/web dev",
    "start:web": "pnpm --filter @permit-portal/web start",
    "build": "pnpm build:operator && pnpm build:web",
    "build:operator": "pnpm --filter @permit-portal/operator build",
    "build:web": "pnpm --filter @permit-portal/web build",
    "lint": "pnpm lint:operator && pnpm lint:web",
    "lint:operator": "pnpm --filter @permit-portal/operator lint",
    "lint:web": "pnpm --filter @permit-portal/web lint",
    "preview": "pnpm --filter @permit-portal/operator preview"
  }
}
